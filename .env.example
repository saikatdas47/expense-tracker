# Render dashboard variables. The app does not read .env files automatically.
NODE_VERSION=24
# For Render Free: add DATABASE_URL using the PostgreSQL Internal Database URL.
# Keep that credential only in Render's environment, never in Git or chat.
# DATABASE_URL=
# SQLite fallback for local use or a disposable free demo only:
DB_PATH=./data/expenses.db
# Render supplies PORT automatically. For local use, the default is 3003.
